{
  "name": "Shop orders from Telegram bot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shop-orders",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Order webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "shop-orders"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.SHOP_WEBHOOK_SECRET;\nconst out = [];\nfor (const item of $input.all()) {\n  const h = item.json.headers || {};\n  const body = JSON.stringify(item.json.body);\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(`${h['x-shop-timestamp']}.${body}`).digest('hex');\n  const got = h['x-shop-signature'] || '';\n  if (got.length !== expected.length || !crypto.timingSafeEqual(Buffer.from(got), Buffer.from(expected))) throw new Error('bad signature');\n  out.push({ json: item.json.body });\n}\nreturn out;"
      },
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.event }}",
              "rightValue": "order.created",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "New order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {},
      "name": "Send SMS / add to courier / CRM (replace me)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, -100]
    },
    {
      "parameters": {},
      "name": "Status changed (replace me)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 100]
    }
  ],
  "connections": {
    "Order webhook": { "main": [[{ "node": "Verify signature", "type": "main", "index": 0 }]] },
    "Verify signature": { "main": [[{ "node": "New order?", "type": "main", "index": 0 }]] },
    "New order?": {
      "main": [
        [{ "node": "Send SMS / add to courier / CRM (replace me)", "type": "main", "index": 0 }],
        [{ "node": "Status changed (replace me)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {}
}
