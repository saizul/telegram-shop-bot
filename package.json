{
  "name": "telegram-shop-bot",
  "version": "0.1.0",
  "description": "Telegram bot for small online shops in Bangladesh: Google Sheets or JSON catalogue, cart, checkout with district-based delivery fees, cash on delivery or bKash reference, admin order actions, Sheets export and n8n webhooks, in Bangla and English.",
  "type": "module",
  "license": "MIT",
  "author": "Saizul Amin",
  "homepage": "https://github.com/saizul/telegram-shop-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saizul/telegram-shop-bot.git"
  },
  "bugs": {
    "url": "https://github.com/saizul/telegram-shop-bot/issues"
  },
  "keywords": [
    "telegram-bot",
    "ecommerce",
    "bangladesh",
    "bkash",
    "cash-on-delivery",
    "google-sheets",
    "n8n",
    "bangla"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "telegram-shop-bot": "dist/src/main.js"
  },
  "files": [
    "dist/src",
    "examples",
    ".env.example",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "dev": "npm run build && node --env-file=.env dist/src/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
