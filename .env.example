# ---- Telegram ----------------------------------------------------------------
# Token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Admin group chat id (negative). Add the bot to the group and send /chatid there.
ADMIN_CHAT_ID=
# Optional: comma-separated Telegram user ids allowed to press order buttons.
ADMIN_USER_IDS=

# polling (default) or webhook
BOT_MODE=polling
# Webhook mode only:
WEBHOOK_URL=
# 16-256 characters of A-Z a-z 0-9 _ -  (for example: openssl rand -hex 32)
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook
PORT=8080
HOST=0.0.0.0

# ---- Shop --------------------------------------------------------------------
SHOP_NAME=Our Shop
# bn or en
DEFAULT_LANG=bn
# bKash personal/merchant number customers "Send Money" to. Leave empty to offer COD only.
BKASH_NUMBER=

# Delivery fees in Taka
DELIVERY_FEE_INSIDE_DHAKA=70
DELIVERY_FEE_OUTSIDE_DHAKA=130
# District ids counted as "inside Dhaka" (see src/bd/districts.ts)
INSIDE_DHAKA_DISTRICTS=dhaka
# Free delivery from this subtotal (leave empty to disable)
FREE_DELIVERY_MIN=

# ---- Catalogue ---------------------------------------------------------------
# json or sheets
CATALOG_SOURCE=json
CATALOG_FILE=./data/catalog.json
CATALOG_TTL_SECONDS=300

# Google Sheets (catalogue and/or order export)
GOOGLE_SHEETS_ID=
SHEETS_PRODUCTS_RANGE=Products!A1:L
# Set to "none" if you have no Categories tab
SHEETS_CATEGORIES_RANGE=Categories!A1:D
# Path to the service account key file (preferred) ...
GOOGLE_SERVICE_ACCOUNT_FILE=
# ... or the whole key JSON in one line
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Orders ------------------------------------------------------------------
SHEETS_EXPORT_ORDERS=false
# Defaults to GOOGLE_SHEETS_ID
SHEETS_ORDERS_ID=
SHEETS_ORDERS_RANGE=Orders!A1
SHEETS_LOG_STATUS_CHANGES=true

# n8n (or any HTTPS endpoint) receiving order.created / order.status_changed
N8N_WEBHOOK_URL=
# Shared secret for the X-Shop-Signature HMAC header
N8N_WEBHOOK_SECRET=

# ---- Storage -----------------------------------------------------------------
# sqlite (Node 22.13+) or json
STORAGE=sqlite
DATA_DIR=./data
# STORAGE_PATH=./data/shop.db

# ---- Anti-spam ---------------------------------------------------------------
RATE_LIMIT_BURST=8
RATE_LIMIT_PER_SECOND=1
SPAM_MUTE_MINUTES=10

LOG_LEVEL=info
